PORT=5000
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_USER=postgres
DB_HOST=localhost
DB_NAME=petroleum_iot
DB_PASSWORD=your_password
DB_PORT=5432

# JWT Config
JWT_SECRET=super_secret_petroleum_iot_key_2026
JWT_EXPIRE=8h
JWT_REFRESH_SECRET=super_refresh_secret_petroleum_iot_2026
JWT_REFRESH_EXPIRE=7d

# Eclipse Mosquitto MQTT Broker Config
MQTT_BROKER=mqtt://localhost:1883
MQTT_PORT=1883
MQTT_TOPIC=petroleum
MQTT_STATUS_TOPIC=petroleum/iot/status/+
MQTT_ALERTS_TOPIC=petroleum/iot/alerts/+
